# Production (Vercel + Neon)
#
# DATABASE_URL is the POOLED endpoint. On Neon the host contains "-pooler".
# ?pgbouncer=true tells Prisma to disable prepared statements, which a
# transaction-mode pooler cannot support.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL is the UNPOOLED endpoint, used only by `prisma migrate`.
# DDL through a pooler is unreliable.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# openssl rand -base64 48
AUTH_SECRET=""
