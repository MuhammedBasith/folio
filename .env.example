# Pooled connection. On Neon this is the "-pooler" host.
# Prisma needs ?pgbouncer=true when the host is a PgBouncer pooler.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"

# Direct (unpooled) connection, used only for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# HS256 signing key for session tokens. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="replace-me-with-at-least-32-characters-of-random"
