# Local development.
#
# Pooled connection. Locally this is just your database; on Neon it is the
# "-pooler" host with ?pgbouncer=true appended.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crossval?schema=public"

# Unpooled connection, used only for migrations. Locally the same string.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crossval?schema=public"

# Session signing key, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Left EMPTY on purpose. A realistic-looking placeholder is worse than none:
# it is long enough to satisfy the length guard, so copying this file verbatim
# yields a working app signing every session with a secret published in the
# repository.
AUTH_SECRET=""

# Whether to believe `x-forwarded-for` when rate limiting.
#
# Defaults to true, which is correct behind any proxy that sets the header
# (Vercel, Cloudflare, nginx): the platform overwrites whatever the client sent,
# so it cannot be forged. Set it to false ONLY when deploying with no proxy in
# front, where a client could supply its own and defeat the limiter. The limiter
# then uses one shared bucket for everybody.
# TRUST_PROXY_HEADERS=true
