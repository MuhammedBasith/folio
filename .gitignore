/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# assignment briefs — private, not part of the submission
/docs

# agent tooling — local only
/.agents
/.claude
skills-lock.json
AGENTS.md
CLAUDE.md

# editors
.idea
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# os
.cache
.temp
.tmp

# prisma
/prisma/*.db
/prisma/*.db-journal

# prisma generated client
/src/generated

# test env
.env.test
